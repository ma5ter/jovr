# Regenerate the Manifest with correct checksums:
# Download the file manually, place it in the /var/cache/distfiles directory,
# then run:
#   ebuild <ebuild-file> digest

EAPI=8

vvv="${PV#*.}"
SLOT="${PV%%.*}.${vvv%%.*}"

EXE="${PN}"
CNAME="Idea"
FNAME="idea-${PV}.tar.gz"

DESCRIPTION="JetBrains ${CNAME} IDE"
HOMEPAGE="https://www.jetbrains.com"
SRC_URI="https://download-cdn.jetbrains.com/idea/${FNAME}"

LICENSE="all-rights-reserved"
KEYWORDS="amd64"
RESTRICT="mirror bindist fetch"

IUSE="-hrdups"

RDEPEND="
	virtual/libcrypt
	>=app-eselect/eselect-jetbrains-0.1
	hrdups? ( >=app-misc/hrdups-1.0.2 )
"

src_unpack() {
	unpack "${FNAME}" || die

	local d
	d=$(find "${WORKDIR}" -mindepth 1 -maxdepth 1 -type d) || die
	[[ -n ${d} ]] || die "Unable to locate extracted source directory"

	mv "${d}" "${S}" || die
}

src_install() {
	dodir /opt/jetbrains
	dodir /usr/share/applications

	cp -a "${S}" "${D}/opt/jetbrains/${PF}" || die

	cat > "${D}/usr/share/applications/${PF}.desktop" <<EOF
[Desktop Entry]
Name=${CNAME} ${PV}
Type=Application
Comment=${DESCRIPTION} ${PV}
Exec=/opt/jetbrains/${PF}/bin/${EXE}
TryExec=/opt/jetbrains/${PF}/bin/${EXE}
Icon=/opt/jetbrains/${PF}/bin/${EXE}.svg
Categories=Development;IDE;
EOF
}

pkg_postinst() {
	if use hrdups; then
		einfo "optimizing install"
		pushd /opt/jetbrains >/dev/null || die
		hrdups -v || die
		popd >/dev/null || die
	fi

	eselect jetbrains set "${PN}" "${PV}"
	einfo "${PF} installed in /opt/jetbrains/${PF}"
}
